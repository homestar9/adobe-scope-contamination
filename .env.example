# ColdBox Name and Environment
APPNAME=adobe-temp
ENVIRONMENT=development

# Database Information
DB_DRIVER=MSSQL
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=adobe-temp
DB_USER=sa
DB_PASSWORD=changeme

# Patched-Quick gate toggles (see patches/quick/README.md).
# off | detect | repair - drives moduleSettings.quick verifyEntityTableOn(Write|Read)
QUICK_VERIFY_ENTITY_TABLE=off
# Comma list of entity mappings for Quick's serial metadata warm-up (empty = disabled)
QUICK_WARMUP=
