+	/**
+	 * Constructs each entity listed in the `metadataWarmupMappings` setting
+	 * once, one at a time, after all modules and application models have
+	 * loaded.  Each construction is shallow: it fills the metadata cache for
+	 * that entity (and its parent entities) without firing `instanceReady`
+	 * events or setting up mementifier.
+	 *
+	 * A failed warm-up never blocks application startup; the entity will
+	 * simply build its metadata on first use, exactly as it does today.
+	 */
+	function afterAspectsLoad() {
+		settings.metadataWarmupMappings.each( function( mapping ) {
+			try {
+				wirebox.getInstance( name = arguments.mapping, initArguments = { "meta" : {}, "shallow" : true } );
+			} catch ( any e ) {
+				try {
+					controller
+						.getLogBox()
+						.getLogger( "quick.ModuleConfig" )
+						.warn( "Quick metadata warm-up failed for [#arguments.mapping#]: #e.message#" );
+				} catch ( any loggingError ) {
+					// Warming up is best-effort; never let it interfere with startup.
+				}
+			}
+		} );
+	}
 
 }
