+	 */
+	function applyColumnFormatter( column ) {
+		param variables._usingQuickColumnFormatter = false;
+		if ( variables._usingQuickColumnFormatter && !isNull( variables.quickBuilder ) ) {
+			return isSimpleValue( arguments.column ) ? variables.quickBuilder.qualifyColumn( arguments.column ) : arguments.column;
+		}
+		return super.applyColumnFormatter( argumentCollection = arguments );
+	}
