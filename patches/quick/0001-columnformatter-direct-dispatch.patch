 	/**
+	 * Switches this builder to format columns by calling `qualifyColumn`
+	 * directly on its paired QuickBuilder instead of through a closure.
+	 *
+	 * A closure created while an object is being constructed keeps a link back
+	 * to the scopes it was created in.  On Adobe ColdFusion, a known engine
+	 * concurrency defect can cross those links between objects constructed at
+	 * the same time, which made the formatter qualify columns with a different
+	 * entity's table name.  A direct method call reads
+	 * `variables.quickBuilder` on this instance at call time, so there is no
+	 * closure link to cross.  It also skips a closure allocation per builder
+	 * and a closure invocation per column on every engine.
+	 *
+	 * Code that reads the formatter with `getColumnFormatter()` keeps working:
+	 * the override below builds an equivalent closure on demand, so plain
+	 * construction never allocates one.  Calling `setColumnFormatter`
+	 * afterwards turns this mode off, so custom formatters keep the same
+	 * precedence they have always had.
+	 *
+	 * @return  quick.models.QuickQB
+	 */
+	public QuickQB function useQuickColumnFormatter() {
+		variables._usingQuickColumnFormatter = true;
+		return this;
+	}
+
+	/**
+	 * Returns the active column formatter.  When `useQuickColumnFormatter` is
+	 * active, an equivalent closure is built on demand for compatibility.
+	 */
+	public any function getColumnFormatter() {
+		param variables._usingQuickColumnFormatter = false;
+		if ( variables._usingQuickColumnFormatter ) {
+			return function( column ) {
+				return variables.quickBuilder.qualifyColumn( arguments.column );
+			};
+		}
+		return variables.columnFormatter;
+	}
+
+	/**
