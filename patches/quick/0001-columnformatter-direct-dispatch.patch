+	 *
+	 * @return  quick.models.QuickQB
+	 */
+	public QuickQB function setColumnFormatter( required any columnFormatter ) {
+		variables._usingQuickColumnFormatter = false;
+		variables.columnFormatter            = arguments.columnFormatter;
+		return this;
+	}
+
+	/**
+	 * Applies the column formatter to a column.  When
+	 * `useQuickColumnFormatter` is active, this dispatches directly to the
