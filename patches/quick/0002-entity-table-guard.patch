+	/**
+	 * Re-asserts the entity's table on the paired qb builder just before a
+	 * statement executes.
+	 *
+	 * On Adobe ColdFusion, a known engine concurrency defect can cross a
+	 * whole `variables` scope between objects constructed at the same time.
+	 * When that happens to a builder, every read from the crossed scope is
+	 * wrong together — the table name AND the entity reference — so a check
+	 * inside the qb builder can see a consistent-looking pair and still
+	 * compile SQL against the wrong table.  This method runs in the
+	 * QuickBuilder and pushes the table read from ITS entity reference into
+	 * the qb object.  The statement then executes against the same table
+	 * that supplied its columns, which is the invariant that prevents
+	 * cross-entity writes.  This mirrors the workaround that has run in
+	 * production: `variables.qb.from( getEntity().tableName() )` just before
+	 * executing.
+	 *
+	 * In "detect" and "repair" modes a visible mismatch announces the
+	 * `quickEntityTableMismatch` interception point.  Only "repair" changes
+	 * the builder — and it pushes even when no mismatch is visible, because
+	 * a fully-crossed scope shows no mismatch.  With both modes "off" (the
+	 * default) this returns after two string comparisons.
+	 *
+	 * @operation  The qb method about to execute.
+	 */
+	private void function assertEntityTableOnQb( required string operation ) {
+		if ( isNull( variables._verifyEntityTableOnWrite ) ) {
+			variables._verifyEntityTableOnWrite = variables.qb.writeVerifyMode();
+		}
+		if ( isNull( variables._verifyEntityTableOnRead ) ) {
+			variables._verifyEntityTableOnRead = variables.qb.readVerifyMode();
+		}
+		if ( variables._verifyEntityTableOnWrite == "off" && variables._verifyEntityTableOnRead == "off" ) {
+			return;
+		}
+		var isWrite = listFindNoCase( "update,insert,upsert,insertUsing,updateOrInsert,delete", arguments.operation ) > 0;
+		var isRead  = arguments.operation == "get";
+		if ( !isWrite && !isRead ) {
+			return;
+		}
+		var mode = isWrite ? variables._verifyEntityTableOnWrite : variables._verifyEntityTableOnRead;
+		if ( mode == "off" ) {
+			return;
+		}
+		var entityTable = getEntity().tableName();
+		if ( !isSimpleValue( entityTable ) || !len( entityTable ) ) {
+			return;
+		}
+		var qbTable = variables.qb.getTableName();
+		if ( !isSimpleValue( qbTable ) || !len( qbTable ) ) {
+			return; // fromRaw / fromSub / expression tables are left alone
+		}
+		if ( compareNoCase( qbTable, entityTable ) != 0 ) {
+			try {
+				getEntity().fireEvent(
+					"EntityTableMismatch",
+					{
+						"operation"     : arguments.operation,
+						"expectedTable" : entityTable,
+						"actualTable"   : qbTable,
+						"repaired"      : mode == "repair"
+					}
+				);
+			} catch ( any e ) {
+				// The announcement must never change the outcome of the statement.
+			}
+		}
+		if ( mode == "repair" ) {
+			variables.qb.from( entityTable );
+		}
+	}
