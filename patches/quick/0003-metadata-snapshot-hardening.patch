 	/**
+	 * Returns a fresh copy of this entity's metadata snapshot, building and
+	 * caching the snapshot on the first request.
+	 *
+	 * On Adobe ColdFusion, a known engine concurrency defect can corrupt
+	 * shared component metadata while it is duplicated by concurrently
+	 * constructing entities (a NullPointerException inside the engine's
+	 * ObjectDuplicator).  Before this method existed, one torn duplication
+	 * could leave a corrupted struct in the metadata cache, and every request
+	 * after that failed until the server restarted.  Two defenses here:
+	 *
+	 * 1. If building or duplicating the snapshot fails, the cached entry is
+	 *    thrown away and the whole thing is retried once.  CacheBox does not
+	 *    cache a value when the producer throws, so a corrupted entry can
+	 *    never stick.
+	 * 2. If the retry fails as well, a clear exception explains the engine
+	 *    defect instead of an inscrutable NullPointerException.
+	 *
+	 * Engines without the defect never enter either catch block.
+	 *
+	 * @cacheKey  The metadata cache key for this entity's mapping.
+	 *
+	 * @return    A metadata struct owned by this instance alone.
+	 */
+	private struct function duplicateMetadataSnapshot( required string cacheKey ) {
+		try {
+			return duplicate(
+				variables._cache.getOrSet( arguments.cacheKey, function() {
+					return buildMetadataSnapshot();
+				} )
+			);
+		} catch ( any e ) {
+			variables._cache.clear( arguments.cacheKey );
+			try {
+				return duplicate(
+					variables._cache.getOrSet( arguments.cacheKey, function() {
+						return buildMetadataSnapshot();
+					} )
+				);
+			} catch ( any e2 ) {
+				variables._cache.clear( arguments.cacheKey );
+				throw(
+					type    = "QuickEntityMetadataException",
+					message = "Failed twice to build or duplicate the metadata for [#variables._mapping#]. On Adobe ColdFusion this is a known engine-level concurrency defect that corrupts shared component metadata during concurrent entity construction. The engine's own metadata may now be corrupted; restarting the server or applying Adobe's hotfix for the defect may be required.",
+					detail  = e2.message
