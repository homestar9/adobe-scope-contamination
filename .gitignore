## Ignored Dependencies
effective-pom.xml
/coldbox/**
/testbox/**
/modules/**
/lib/**
# Application.cfc loads Java from lib/java, so the empty folder must exist in a fresh clone.
!/lib/java/
/lib/java/*
!/lib/java/.gitkeep

